# Copier ce fichier en .env.local (ignoré par git) pour le configurer localement.

# "mock" (défaut) : utilise src/lib/api/mocks, aucun backend requis.
# "live" : appelle NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_API_MODE=mock

# URL du backend Spring Boot, utilisée uniquement en mode "live".
NEXT_PUBLIC_API_URL=http://localhost:8080

# Simulation de panne réseau (dev/tests uniquement) — taux de 0 à 1,
# ex 0.2 = 20% de chance qu'un appel échoue. 0 = désactivé (défaut,
# comportement normal, aucun ralentissement). Peut aussi être activé à la
# volée via le toggle "Panne réseau" en mode dev, sans modifier ce fichier
# ni relancer le serveur.
NEXT_PUBLIC_SIMULATE_NETWORK_FAILURE_RATE=0
